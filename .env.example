# Copy the backend block to backend/.env and the frontend block to frontend/.env.
# Placeholders only. Never commit real values: .env files are git-ignored.
# Every line below is optional except where noted; the defaults are shown.

# --- Backend (backend/.env; run the backend from the backend/ folder) ---
# FABRICOPS_APP_NAME=FabricOps
FABRICOPS_ENVIRONMENT=local
FABRICOPS_LOG_LEVEL=INFO
FABRICOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLite file. Default: backend/data/fabricops.db
# FABRICOPS_DATABASE_PATH=
# Largest request body accepted, in bytes (larger gets HTTP 413)
# FABRICOPS_MAX_REQUEST_BYTES=65536

# LLM provider. Backend only: the browser never sees these.
# To use OpenAI, uncomment these three lines and paste your key (the file is git-ignored):
# FABRICOPS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-replace-me
# FABRICOPS_LLM_MODEL=gpt-4.1               # optional; the default for openai is gpt-4.1
# For Anthropic use ANTHROPIC_API_KEY (or FABRICOPS_LLM_API_KEY) and the default model claude-opus-5-5.
# Needed only for investigations that reach the model (stale-telemetry runs abstain without it).
# Provider choices: anthropic (default) | openai | demo (a scripted stand-in, not an AI) | mock
# FABRICOPS_LLM_API_KEY=replace-me          # one key for whichever provider is selected; or use the provider's own variable
# FABRICOPS_LLM_EFFORT=high                 # low | medium | high | xhigh | max (OpenAI: only sent to reasoning models)
# FABRICOPS_LLM_MAX_TOKENS=8000
# FABRICOPS_LLM_TIMEOUT_SECONDS=120
# FABRICOPS_LLM_MAX_ATTEMPTS=3              # bounded retries, transient errors only
# FABRICOPS_LLM_ENABLE_FALLBACKS=true       # server-side refusal fallbacks (Anthropic only)

# DEMO approval identity (a labelled stand-in, not authentication) and proposal lifetime
# FABRICOPS_DEMO_REVIEWERS=demo-reviewer    # comma-separated
# FABRICOPS_APPROVAL_TTL_MINUTES=1440

# --- Frontend (frontend/.env) ---
# Public values only. Never put provider keys here.
VITE_API_BASE_URL=http://localhost:8000
