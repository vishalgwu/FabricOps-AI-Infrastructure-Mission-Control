# Copy to backend/.env (backend) and frontend/.env (frontend). Placeholders only; never commit real values.

# --- Backend (backend/.env) ---
FABRICOPS_ENVIRONMENT=local
FABRICOPS_LOG_LEVEL=INFO
FABRICOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Phase 06: LLM provider settings (backend only; the browser never sees these)
# FABRICOPS_LLM_PROVIDER=anthropic
# FABRICOPS_LLM_API_KEY=replace-me

# --- Frontend (frontend/.env) ---
# Public values only. Never put provider keys here.
VITE_API_BASE_URL=http://localhost:8000
