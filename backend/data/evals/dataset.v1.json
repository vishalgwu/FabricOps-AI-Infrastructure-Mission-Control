        "proposal": {"risk_class": "read_only_diagnostic", "approval_status": "not_required", "scope": ["net-h01"]}
      }
    },
    {
      "id": "E03", "title": "Stale telemetry", "covers": "Stale telemetry",
      "scenario": "stale_telemetry", "affected_hosts": ["gpu-h21"], "behavior": "must_not_be_called",
      "expected": {
        "run_status": "ABSTAINED", "model_calls": 0, "report": "present", "insufficient_evidence": true,
        "missing_evidence_contains": ["stale", "peer"], "evidence": "none", "proposal": "none"
      }
    },
    {
      "id": "E04", "title": "Missing telemetry (host has no metrics at all)", "covers": "Missing telemetry",
