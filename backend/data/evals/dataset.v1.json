        "run_status": "COMPLETE", "model_calls": 1, "report": "present", "insufficient_evidence": false,
        "citations_valid": true,
        "must_retrieve": [
          {"host": "net-h01", "metric": "link_error_count"}, {"host": "net-h01", "metric": "link_retrain_count"},
          {"host": "net-h02", "metric": "link_error_count"}, {"host": "net-h03", "metric": "link_error_count"}
